DATA_ROOT=/var/lib/sic-attendance
MODEL_ROOT=/opt/sic-attendance
MODEL_PACK=pi4_fp32
PI_ID=pi-classroom-01

CAMERA_COUNT=3
CAMERA_1_ID=camera-1
CAMERA_1_NAME=Camera 1
CAMERA_1_SOURCE=/dev/v4l/by-id/REPLACE_CAMERA_1
CAMERA_2_ID=camera-2
CAMERA_2_NAME=Camera 2
CAMERA_2_SOURCE=/dev/v4l/by-id/REPLACE_CAMERA_2
CAMERA_3_ID=camera-3
CAMERA_3_NAME=Camera 3
CAMERA_3_SOURCE=/dev/v4l/by-id/REPLACE_CAMERA_3

FRAME_WIDTH=640
FRAME_HEIGHT=480
MONITOR_FPS=4
PREVIEW_FPS=30
MOTION_MIN_AREA=1800
CAMERA_TRIGGER_COOLDOWN_SECONDS=0.8
FRAME_QUEUE_SIZE=9
FACE_DET_SIZE=320

MATCH_THRESHOLD=0.45
MATCH_MARGIN=0.06
MIN_DETECTION_SCORE=0.60
MIN_FACE_QUALITY=0.35
ATTENDANCE_COOLDOWN_SECONDS=300

SAVE_UNKNOWN_IMAGES=true
UNKNOWN_RETENTION_DAYS=14

API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=
API_AUTH_MODE=shared_token
# Required for shared_token mode. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SHARED_TOKEN=

CLOUD_SUMMARY_ENABLED=false
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
LOG_LEVEL=INFO
