[Unit]
Description=SIC three-camera Pi 4 attendance service
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=REPLACE_ROOT
EnvironmentFile=REPLACE_ROOT/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=REPLACE_ROOT/.venv/bin/sic-pi4
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/sic-attendance /opt/sic-attendance/models

[Install]
WantedBy=multi-user.target
